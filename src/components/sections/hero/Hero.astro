---
import IconWork from "@/components/icons/IconWork.astro";
import IconRowRigth from "@/components/icons/IconRowRigth.astro";
import IconGithub from "@/components/icons/IconGithub.astro";
import IconLinkedin from "@/components/icons/IconLinkedin.astro";
import HeroIcon from "./HeroIcon.astro";
import ContainerSection from "@/components/ui/ContainerSection.astro";
import CardHero from "./CardHero.astro";
import ListOfHabilities from "./ListOfHabilities.astro";
import ListOfTechnologies from "./ListOfTechnologies.astro";
import { Image } from "astro:assets";
import Button from "@/components/atoms/Button.astro";
---

<ContainerSection className="py-0" id="hero">
  <div class="w-full flex flex-col sm:flex-row min-h-screen relative">
    <div
      class="hidden sm:flex w-96 h-96 bg-gradient-to-r -bottom-1/3 from-primary to-secondary opacity-10 blur-3xl absolute left-1/2 transform -translate-x-1/2 rounded-full -z-10"
    >
    </div>
    <div
      class="w-full sm:w-1/2 pt-28 pb-40 sm:pb-0 sm:pt-0 min-h-screen flex flex-col gap-16 sm:gap-10 sm:justify-center relative"
    >
      <div
        class="sm:hidden w-96 h-96 bg-gradient-to-r -bottom-1/3 from-primary to-secondary opacity-10  blur-3xl absolute left-1/2 transform -translate-x-1/2 rounded-full -z-10"
      >
      </div>
      <div class="flex flex-col gap-4">
        <p class="text-foreground-muted text-sm md:text-base italic">
          <span data-lang="es">Llevando tus proyectos web al siguiente nivel</span>
          <span data-lang="en" style="display:none">Taking your web projects to the next level</span>
        </p>
        <div class="flex flex-col gap-3">
          <h1
            class="text-foreground text-5xl sm:text-3xl md:text-4xl lg:text-5xl font-bold"
          >
            Fullstack <span class="text-primary">Software</span> Developer
          </h1>
          <h2 class="text-foreground-secondary text-base sm:text-base lg:text-lg">
            <span data-lang="es">Soy Juan. Construyo productos web completos, desde interfaces cuidadas hasta APIs y servicios backend.</span>
            <span data-lang="en" style="display:none">I'm Juan. I build complete web products, from polished interfaces to APIs and backend services.</span>
          </h2>
        </div>
      </div>
      <div class="flex flex-col gap-3">
        <div class="flex flex-col sm:flex-row gap-4 sm:gap-3">
          <Button href="/#works" intent="secondary">
            <IconWork />
            <span data-lang="es">Proyectos</span>
            <span data-lang="en" style="display:none">Projects</span>
          </Button>
          <Button id="descargar-cv" intent="outline" class="px-5">
            <span data-lang="es">Descargar CV</span>
            <span data-lang="en" style="display:none">Download CV</span>
          </Button>
        </div>
        <div class="flex justify-center fixed bottom-8 left-0 w-full">
          <div
            id="fadeElement"
            class="p-1 border-2 sm:border border-[#fff5] rounded-full animate-bounce filter backdrop-blur-2xl z-50"
          >
            <a
              href="/#works"
              class="cursor-pointer"
              aria-label="Ir a experiencia"
            >
              <IconRowRigth
                width="35"
                height="35"
                className="rotate-90 stroke-[#fff5] stroke-2 sm:stroke-1"
              />
            </a>
          </div>
        </div>
      </div>
    </div>

    <div
      class="w-full py-36 sm:py-0 sm:w-1/2 sm:min-h-screen flex justify-center items-center"
    >
      <div class="relative">
        <!-- Card habilidades -->

        <CardHero
          className="-top-[60%] -left-[15%] sm:-top-[40%] sm:-left-[10%]  md:-left-1/4 md:-top-[40%] lg:-left-1/2 lg:-top-[35%]"
          title="Habilidades"
          titleEn="Skills"
        >
          <ListOfHabilities />
        </CardHero>

        <!-- Card Github -->
        <HeroIcon
          url="https://github.com/JuanPE44"
          className="-top-[15%] -right-[15%]"
        >
          <IconGithub width="35" height="35" />
        </HeroIcon>
        <Image
          alt="imagen hero"
          src="/images/foto-hero.webp"
          width="240"
          height="208"
          class="rounded-2xl w-60 h-52 object-cover"
        />

        <!-- Card Linkedin -->
        <HeroIcon
          url="https://www.linkedin.com/in/juan-peñalba-0025b6246/"
          className=" -bottom-[15%] -left-[15%] "
        >
          <IconLinkedin width="35" height="35" />
        </HeroIcon>

        <!-- Card Tecnologicas -->
        <CardHero
          className="card-hero2 -bottom-[60%] -right-[19%] sm:-bottom-[45%] sm:-right-[20%] md:-bottom-[40%] md:-right-1/3 lg:-right-[43%]"
          title="Mis tecnologías preferidas"
          titleEn="My favorite technologies"
        >
          <ListOfTechnologies />
        </CardHero>
      </div>
    </div>
  </div>
</ContainerSection>

<script>
  const handleScroll = () => {
    const element = document.getElementById("fadeElement");
    if (!element) return;

    const scrollY = window.scrollY;
    const maxFadePoint = 300; // Punto en el que la opacidad llega a 0
    const opacity = Math.max(1 - scrollY / maxFadePoint, 0);

    element.style.opacity = opacity.toString();

    if (scrollY > maxFadePoint) {
      element.style.display = "none";
    } else {
      element.style.display = "block";
    }
  };

  if (typeof window !== "undefined") {
    window.addEventListener("scroll", handleScroll);
  }
</script>
