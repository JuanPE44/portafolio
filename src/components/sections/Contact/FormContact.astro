---
import Input from "@/components/ui/Input.astro";
---

<form
  id="contact-form"
  method="POST"
  class="relative p-8 md:p-10 border border-color-border bg-surface  rounded-2xl max-w-lg mx-auto"
>
  <!-- Fondo decorativo -->
  <div
    class="absolute -top-6 -right-6 w-24 h-24 bg-gradient-to-r from-primary to-secondary opacity-10 blur-2xl rounded-full"
  >
  </div>

  <h3 class="text-white/90 text-2xl font-bold mb-6 text-center">
    <span data-lang="es">Envíame un mensaje</span>
    <span data-lang="en" style="display:none">Send me a message</span>
  </h3>

  <!-- Mensajes -->
  <div
    id="success-message"
    class="hidden bg-gradient-to-r from-secondary/20 to-secondary/10 border border-secondary/30 text-secondary p-4 rounded-xl mb-4 animate-fade-in"
  >
    <div class="flex items-center gap-3">
      <svg
        class="text-secondary flex-shrink-0"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        ><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline
          points="22,4 12,14.01 9,11.01"></polyline></svg
      >
      <div>
        <p class="font-semibold">
          <span data-lang="es">¡Mensaje enviado correctamente!</span>
          <span data-lang="en" style="display:none">Message sent successfully!</span>
        </p>
        <p class="text-sm text-secondary/80">
          <span data-lang="es">Te responderé a la brevedad. Gracias por contactarme.</span>
          <span data-lang="en" style="display:none">I'll get back to you soon. Thanks for reaching out.</span>
        </p>
      </div>
    </div>
  </div>

  <div
    id="error-message"
    class="hidden bg-gradient-to-r from-red-500/20 to-red-500/10 border border-red-500/30 text-red-400 p-4 rounded-xl mb-4 animate-fade-in"
  >
    <div class="flex items-center gap-3">
      <svg
        class="text-red-400 flex-shrink-0"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        ><circle cx="12" cy="12" r="10"></circle><line
          x1="15"
          y1="9"
          x2="9"
          y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg
      >
      <div>
        <p class="font-semibold">
          <span data-lang="es">Error al enviar el mensaje</span>
          <span data-lang="en" style="display:none">Error sending the message</span>
        </p>
        <p class="text-sm text-red-400/80">
          <span data-lang="es">Por favor, intenta nuevamente o contáctame por WhatsApp.</span>
          <span data-lang="en" style="display:none">Please try again or contact me via WhatsApp.</span>
        </p>
      </div>
    </div>
  </div>

  <div
    id="loading-message"
    class="hidden bg-gradient-to-r from-primary/20 to-primary/10 border border-primary/30 text-primary p-4 rounded-xl mb-4 animate-pulse"
  >
    <div class="flex items-center gap-3">
      <svg
        class="text-primary animate-spin flex-shrink-0"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"><path d="M21 12a9 9 0 11-6.219-8.56"></path></svg
      >
      <p class="font-semibold">
        <span data-lang="es">Enviando mensaje...</span>
        <span data-lang="en" style="display:none">Sending message...</span>
      </p>
    </div>
  </div>

  <!-- Hidden inputs -->
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_template" value="table" />

  <!-- Campos del formulario -->
  <div class="space-y-4">
    <Input name="name" type="text" placeholder="Tu nombre completo" data-placeholder-es="Tu nombre completo" data-placeholder-en="Your full name" />
    <Input name="email" type="email" placeholder="Tu correo electrónico" data-placeholder-es="Tu correo electrónico" data-placeholder-en="Your email address" />
  </div>

  <textarea
    name="message"
    required
    placeholder="Contame sobre tu proyecto..."
    data-placeholder-es="Contame sobre tu proyecto..."
    data-placeholder-en="Tell me about your project..."
    rows="5"
    class="w-full text-white/90 border border-color-border bg-surface  rounded-xl py-3 px-4 mt-4 focus:outline-none focus:ring-2 focus:ring-secondary focus:border-transparent resize-none"
  ></textarea>
  <button
    type="submit"
    id="submit-button"
    class="w-full bg-secondary cursor-pointer text-background font-bold py-3 px-4 rounded-xl mt-6 hover:scale-105 transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100"
  >
    <span id="button-text">
      <span data-lang="es">Enviar mensaje</span>
      <span data-lang="en" style="display:none">Send message</span>
    </span>
  </button>
</form>

<script type="module">
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form");
    const submitButton = document.getElementById("submit-button");
    const buttonText = document.getElementById("button-text");
    const successMessage = document.getElementById("success-message");
    const errorMessage = document.getElementById("error-message");
    const loadingMessage = document.getElementById("loading-message");

    const showMessage = (element, duration = 6000) => {
      element?.classList.remove("hidden");
      setTimeout(() => {
        element?.classList.add("hidden");
      }, duration);
    };

    const hideAllMessages = () => {
      successMessage?.classList.add("hidden");
      errorMessage?.classList.add("hidden");
      loadingMessage?.classList.add("hidden");
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      hideAllMessages();
      showMessage(loadingMessage);
      submitButton.disabled = true;
      const lang = localStorage.getItem('lang') || 'es';
      buttonText.textContent = lang === 'es' ? "Enviando..." : "Sending...";

      const formData = new FormData(form);
      const data = {
        name: formData.get("name"),
        email: formData.get("email"),
        message: formData.get("message"),
      };

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        loadingMessage?.classList.add("hidden");

        if (res.ok) {
          showMessage(successMessage, 8000);
          form.reset();
        } else {
          throw new Error("Error al enviar el formulario");
        }
      } catch (err) {
        loadingMessage?.classList.add("hidden");
        showMessage(errorMessage, 8000);
        console.error(err);
      } finally {
        submitButton.disabled = false;
        const currentLang = localStorage.getItem('lang') || 'es';
        buttonText.textContent = currentLang === 'es' ? "Enviar mensaje" : "Send message";
      }
    });

    // Validación visual
    const inputs = form.querySelectorAll("input[required], textarea[required]");
    inputs.forEach((input) => {
      input.addEventListener("invalid", (e) => {
        e.preventDefault();
        const target = e.target;
        target.classList.add("border-red-500");
        target.addEventListener(
          "input",
          () => {
            target.classList.remove("border-red-500");
          },
          { once: true }
        );
      });
    });
  });
</script>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.3s ease-out;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin {
    animation: spin 1s linear infinite;
  }
</style>
