---
import {
  projectDetailsChabit,
  projectDetailsMamparas,
  projectDetailsPracticas,
  projectDetailsPrimarket,
} from "@/data/projectsDetails";
import CardExperience from "./CardExperience.astro";
---

<div class="borde-parcial-l pb-12 pt-28 flex flex-col gap-10 grow">
  <CardExperience
    id="modal-0"
    details={projectDetailsChabit}
    title="Desarrollador de Software"
    titleEn="Software Developer"
    jobTitle="Chabit"
    date="Septiembre 2025 - Actualidad"
    dateEn="September 2025 - Present"
    description="Lideré el desarrollo del sitio web con Astro y React, implementando experiencias 3D y animaciones avanzadas con Three.js, Spline y GSAP. Desarrollé una librería interna de componentes UI con React y React Native, documentada con Storybook y distribuida como paquete privado vía GitHub Packages."
    descriptionEn="Led the website development with Astro and React, implementing 3D experiences and advanced animations using Three.js, Spline, and GSAP. Built an internal UI component library with React and React Native, documented with Storybook and distributed as a private package via GitHub Packages."
  />
  <CardExperience
    id="modal-1"
    details={projectDetailsPrimarket}
    title="Desarrollador Frontend"
    titleEn="Frontend Developer"
    jobTitle="Primarket"
    date="Julio 2025 - Actualidad"
    dateEn="July 2025 - Present"
    description="Participé activamente en el desarrollo e implementación de interfaces web utilizando Next.js y Material UI, garantizando soluciones eficientes, coherentes y visualmente atractivas. Desarrolle e implemento componentes reutilizables siguiendo especificaciones de diseño y feedback continuo del equipo. Construí vistas y estructuras escalables con Next.js, optimizando el rendimiento y la experiencia del usuario. Apliqué estilos y lógica visual mediante Material UI, alineando la implementación con los estándares de diseño. Aseguré buenas prácticas de maquetación responsive y accesibilidad, mejorando la usabilidad en múltiples dispositivos y contextos."
    descriptionEn="Actively participated in the development of web interfaces using Next.js and Material UI. Built reusable components following design specifications and team feedback. Created scalable structures with Next.js, optimizing performance and user experience. Applied styles via Material UI aligned with design standards. Ensured responsive and accessible layouts across multiple devices."
  />
  <CardExperience
    id="modal-2"
    details={projectDetailsMamparas}
    title="Desarrollador Frontend"
    titleEn="Frontend Developer"
    jobTitle="Freelancer"
    date="Abril 2024 - Junio 2024"
    dateEn="April 2024 - June 2024"
    description="Me encargue del diseño y desarrollo del sitio web para Mamparas Esmeralda, donde lideré la planificación del proyecto y realicé el diseño personalizado del sitio. Utilicé Astro para el desarrollo, optimicé tanto el SEO como el rendimiento de la web, y añadí secciones para mostrar productos y promociones."
    descriptionEn="Designed and developed the website for Mamparas Esmeralda, leading project planning and creating a custom design. Used Astro for development, optimized SEO and performance, and added product and promotions sections."
  />
  <CardExperience
    id="modal-3"
    details={projectDetailsPracticas}
    title="Desarrollador Fullstack"
    titleEn="Fullstack Developer"
    jobTitle="Prácticas Profesionales"
    date="Marzo 2023 - Diciembre 2023"
    dateEn="March 2023 - December 2023"
    description="Durante el último año de mi tecnicatura en programación, tuve la oportunidad de participar en proyectos destacados que fortalecieron mis habilidades técnicas y mi capacidad de trabajo en equipo."
    descriptionEn="During the final year of my programming degree, I participated in notable projects that strengthened my technical skills and teamwork abilities."
  />
</div>

<style>
  .borde-parcial-l {
    border-left: 2px solid;
    border-image: linear-gradient(
      to bottom,
      transparent 1%,
      color-mix(in srgb, var(--color-secondary) 20%, transparent) 30%
    );
    border-image-slice: 1;
  }
</style>
